# --- Zora API ---------------------------------------------------------------
# Free key from https://zora.co/settings/developer — raises rate limits.
# The bot works without one for light polling, but a key is recommended.
ZORA_API_KEY=

# --- Mode -------------------------------------------------------------------
# Paper trading (no real transactions) is the default. The bot ONLY sends real
# trades when BOTH of these are set:
#   LIVE_TRADING=true
#   PRIVATE_KEY=0x...   (a burner wallet on Base funded with a small amount of ETH)
LIVE_TRADING=false
PRIVATE_KEY=

# Base mainnet RPC. The public endpoint works; a dedicated one (Alchemy etc.) is more reliable.
RPC_URL=https://mainnet.base.org

# --- Strategy: entry filters -------------------------------------------------
# Scan interval in seconds
POLL_SECONDS=60
# Only consider coins whose market cap moved up at least this % in 24h
MIN_24H_GAIN_PCT=20
# Liquidity/interest floors (USD)
MIN_VOLUME_24H_USD=5000
MIN_MARKET_CAP_USD=10000
# Avoid already-huge coins where the move has likely happened
MAX_MARKET_CAP_USD=2000000
# Minimum distinct holders (filters one-wallet pumps)
MIN_UNIQUE_HOLDERS=25

# --- Strategy: exits ----------------------------------------------------------
TAKE_PROFIT_PCT=30
STOP_LOSS_PCT=15
# Force-exit a position after this many minutes regardless of P&L
MAX_HOLD_MINUTES=240

# --- Risk limits --------------------------------------------------------------
# Per-trade size. In paper mode this is tracked in USD terms via TRADE_SIZE_USD.
TRADE_SIZE_ETH=0.005
TRADE_SIZE_USD=15
MAX_OPEN_POSITIONS=3
# Stop opening new positions for the day once realized losses exceed this (USD)
DAILY_LOSS_LIMIT_USD=50
# After selling a coin, don't re-enter it for this many minutes
REENTRY_COOLDOWN_MINUTES=360
# Slippage tolerance for live trades (0.05 = 5%)
SLIPPAGE=0.05
